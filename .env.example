DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# ── Correo saliente (SMTP). Para Gmail usa una contrasena de aplicacion ───────
# IMPORTANTE: una cuenta Gmail personal NO es un servidor transaccional fiable.
# Gmail acepta el envio (Django registra "correo.enviado ... enviados=1") pero
# puede BLOQUEAR el mensaje al entregarlo a otro buzon y devolver un bounce
# "Mail Delivery Subsystem - El mensaje se ha bloqueado" al remitente.
# Para produccion usa un proveedor transaccional (Brevo, SendGrid, Resend,
# Mailgun) o una cuenta Google Workspace con el dominio verificado
# (SPF/DKIM/DMARC), cambiando solo estas variables.
# `correo_personal` de cada usuario debe ser un buzon que realmente pueda
# recibir correo: ahi se envian los OTP, las credenciales y la recuperacion.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=correo@dominio.com
EMAIL_TIMEOUT=20

# ── Autenticacion en dos pasos (2FA / OTP) ────────────────────────────────────
OTP_ISSUER='U.E. Fe y Alegria'
OTP_TTL_MINUTOS=10
OTP_MAX_INTENTOS=5
OTP_LOGIN_TTL_MINUTOS=5
OTP_2FA_POR_DEFECTO=True
AUTH_TEMP_PASSWORD_MAX_AGE=259200

# ── Frontend (enlaces incluidos en los correos) ───────────────────────────────
FRONTEND_BASE_URL=http://localhost:3000

# las variable de entorno son la mismas variable que se les paso en chat de te

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True
API_DOCS_PUBLIC=True

# ── Sesion (token firmado / cookie) ───────────────────────────────────────────
AUTH_TOKEN_MAX_AGE=86400
AUTH_TOKEN_SALT=ue.panama.auth
AUTH_COOKIE_NAME=auth_token

# ── Codigos OTP (2FA / recuperacion) ──────────────────────────────────────────
OTP_CODIGO_DIGITOS=6
OTP_TOTP_INTERVALO=30
OTP_TOTP_VENTANA=1
OTP_PENDING_TOKEN_MAX_AGE=600
EMAIL_SUBJECT_PREFIX='[U.E. Fe y Alegria] '


